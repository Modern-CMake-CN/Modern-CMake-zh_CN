e","lang":"cmake","value":"# 假设规范版本号写在单独一行中\n# 如果分别从 MAJOR、MINOR 等宏中读取，则需要拆分为几个部分\nset(VERSION_REGEX \"#define MY_VERSION[ \\t]+\\\"(.+)\\\"\")\n\n# 读入包含版本号的那一行\nfile(STRINGS \"${CMAKE_CURRENT_SOURCE_DIR}/include/My/Version.hpp\"\n    VERSION_STRING REGEX ${VERSION_REGEX})\n\n# 仅提取出版本号本身\nstring(REGEX REPLACE ${VERSION_REGEX} \"\\\\1\" VERSION_STRING \"${VERSION_STRING}\")\n\n# 自动获取 PROJECT_VERSION_MAJOR、My_VERSION_MAJOR 等变量\nproject(My LANGUAGES CXX VERSION ${VERSION_STRING})","position":{"start":{"line":40,"column":1},"end":{"line":54,"column":1}},"key":"J9xUu4EjvI"},{"type":"paragraph","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"children":[{"type":"text","value":"如上所示， ","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"tivRA4E7iJ"},{"type":"inlineCode","value":"file(STRINGS file_name variable_name REGEX regex)","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"Jw5ETcPL55"},{"type":"text","value":" 选择了与正则表达式相匹配的行，并且使用了相同的正则表达式来匹配出其中版本号的部分。","position":{"start":{"line":56,"column":1},"end":{"line":56,"column":1}},"key":"vIQWqdSIzV"}],"key":"Kfzrn7ly4e"}],"key":"IYBbTZUlNz"}],"key":"rz9UeT93DI"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"用 CMake 进行编程","url":"/functions","group":"基础知识"},"next":{"title":"如何组织你的项目","url":"/structure","group":"基础知识"}}},"domain":"http://pre.render"}